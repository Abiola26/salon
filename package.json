{
  "name": "salon",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "dev": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm run test --prefix backend",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "ci": "npm run lint && npm run test:ci --prefix backend && npm run build --prefix frontend",
    "prisma:migrate:check": "npm run prisma:migrate:prod --prefix backend"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^14.0.0"
  },
  "lint-staged": {
    "backend/src/**/*.js": [
      "npm run lint --prefix backend"
    ],
    "frontend/src/**/*.{js,jsx,ts,tsx,json,css,md}": [
      "npm run lint --prefix frontend"
    ]
  }
}