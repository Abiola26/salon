// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StripePaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AuditAction {
  CREATE_SERVICE
  UPDATE_SERVICE
  DELETE_SERVICE
  CONFIRM_APPOINTMENT
  CANCEL_APPOINTMENT
  DELETE_USER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password             String
  phone                String?
  role                 Role          @default(CUSTOMER)
  refreshToken         String?
  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  appointments         Appointment[]
  payments             Payment[]
  auditLogs            AuditLog[]
  reviews              Review[]

  @@map("users")
}

model Service {
  id          String        @id @default(uuid())
  name        String
  description String
  duration    Int           // in minutes
  price       Decimal       @db.Decimal(10, 2)
  image       String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  appointments Appointment[]
  reviews      Review[]

  @@map("services")
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String
  serviceId       String
  appointmentDate DateTime          @db.Date
  appointmentTime String            // e.g. "10:00"
  status          AppointmentStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(UNPAID)
  amountPaid      Decimal           @default(0) @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  payments Payment[]
  review   Review?

  // Prevent double booking: same date + time slot can only be booked once (non-cancelled)
  @@unique([appointmentDate, appointmentTime, status], name: "unique_slot")
  @@index([userId])
  @@index([serviceId])
  @@index([appointmentDate])
  @@map("appointments")
}

model Payment {
  id                    String              @id @default(uuid())
  userId                String
  appointmentId         String
  stripePaymentIntentId String              @unique
  amount                Decimal             @db.Decimal(10, 2)
  currency              String              @default("usd")
  status                StripePaymentStatus @default(PENDING)
  paymentType           String              @default("FULL") // FULL or DEPOSIT
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appointmentId])
  @@map("payments")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  details   String
  ipAddress String?
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model EmailQueue {
  id        String      @id @default(uuid())
  to        String
  subject   String
  html      String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@map("email_queue")
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique  // one review per appointment
  userId        String
  serviceId     String
  rating        Int         // 1–5 stars
  comment       String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([userId])
  @@map("reviews")
}
