// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum StripePaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AuditAction {
  CREATE_SERVICE
  UPDATE_SERVICE
  DELETE_SERVICE
  CONFIRM_APPOINTMENT
  CANCEL_APPOINTMENT
  DELETE_USER
  CREATE_STAFF
  UPDATE_STAFF
  DELETE_STAFF
  CREATE_STAFF_LEAVE
  DELETE_STAFF_LEAVE
  CREATE_COUPON
  UPDATE_COUPON
  DELETE_COUPON
  USER_REGISTERED
  USER_LOGIN
  TOKEN_REFRESHED
  USER_LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  REFUND_PAYMENT
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password             String
  phone                String?
  role                 Role          @default(CUSTOMER)
  resetPasswordToken   String?
  resetPasswordExpiry  DateTime?
  loyaltyPoints        Int           @default(0)
  // Soft delete (Phase 3): deletion anonymizes PII (name/email/phone/password)
  // instead of hard-deleting — appointments, payments, reviews and audit logs
  // all reference the user, and a hard delete would CASCADE them away.
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  appointments         Appointment[]
  payments             Payment[]
  auditLogs            AuditLog[]
  reviews              Review[]
  refreshTokens        RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  // SHA-256 of the refresh JWT — the raw token is never stored server-side.
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  // Set when the session is revoked (logout, password reset) OR rotated by a
  // refresh. Presenting a token that already has revokedAt ⇒ replay/leak ⇒
  // every active session for that user gets revoked (reuse detection).
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Staff {
  id           String        @id @default(uuid())
  name         String
  bio          String?       @db.Text
  image        String?
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  services     Service[]     // Implicit join table _ServiceToStaff
  appointments Appointment[]
  leaves       StaffLeave[]

  @@map("staff")
}

// Blackout ranges: a stylist on leave cannot be booked (availability slots,
// createAppointment and rescheduleAppointment all check this table).
model StaffLeave {
  id         String   @id @default(uuid())
  staffId    String
  // Date-only (inclusive range) — normalized to UTC midnight by the service.
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startDate, endDate])
  @@map("staff_leave")
}

model Service {
  id          String        @id @default(uuid())
  name        String
  description String
  duration    Int           // in minutes
  price       Decimal       @db.Decimal(10, 2)
  image       String?
  isActive    Boolean       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  appointments Appointment[]
  reviews      Review[]
  staff        Staff[]       // Implicit join table _ServiceToStaff

  @@map("services")
}

model Coupon {
  id            String        @id @default(uuid())
  code          String      @unique
  discountType  CouponType
  discountValue Decimal       @db.Decimal(10, 2)
  isActive      Boolean       @default(true)
  startDate     DateTime?
  endDate       DateTime?
  maxUsage      Int?
  usageCount    Int           @default(0)
  // Soft delete (Phase 3): on delete the code is suffixed
  // ("<CODE> (deleted <id6)>") so the unique constraint frees the original
  // code for reuse while appointment history keeps a recognizable value.
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointments  Appointment[]

  @@map("coupons")
}

model Appointment {
  id              String            @id @default(uuid())
  userId          String
  serviceId       String
  staffId         String?
  couponId        String?
  appointmentDate DateTime          @db.Date
  appointmentTime String            // e.g. "10:00"
  status          AppointmentStatus @default(PENDING)
  paymentStatus   PaymentStatus     @default(UNPAID)
  amountPaid      Decimal           @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(10, 2)
  pointsRedeemed  Int               @default(0)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  coupon   Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payments Payment[]
  review   Review?

  // Slot exclusivity is enforced in code, NOT by a unique index:
  // appointment.service.js takes a per-date Postgres advisory lock inside a
  // transaction and then runs a duration-aware overlap check (checkSlotConflict).
  // Do NOT re-add a unique constraint on (date, time, staff[, status]) — the old
  // "unique_slot" included `status` (PENDING + CONFIRMED could coexist at the
  // same slot) and NULL staffId defeated it entirely in Postgres.
  @@index([userId])
  @@index([serviceId])
  @@index([staffId])
  // Availability + conflict-check hot path (date range scans with staff/status).
  @@index([appointmentDate, staffId, status])
  @@map("appointments")
}

model Payment {
  id                    String              @id @default(uuid())
  userId                String
  appointmentId         String
  stripePaymentIntentId String              @unique
  amount                Decimal             @db.Decimal(10, 2)
  currency              String              @default("cad")
  status                StripePaymentStatus @default(PENDING)
  paymentType           String              @default("FULL") // FULL or DEPOSIT
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([appointmentId])
  @@map("payments")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  details   String
  ipAddress String?
  createdAt DateTime    @default(now())

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model EmailQueue {
  id        String      @id @default(uuid())
  to        String
  subject   String
  html      String
  // Optional RFC 5545 calendar payload — sent as a text/calendar attachment
  // so booking emails can be added to the customer's calendar.
  ics       String?
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Queue processor: WHERE status = PENDING ORDER BY createdAt (composite).
  @@index([status, createdAt])
  @@map("email_queue")
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique  // one review per appointment
  userId        String
  serviceId     String
  rating        Int         // 1–5 stars
  comment       String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([userId])
  @@map("reviews")
}
