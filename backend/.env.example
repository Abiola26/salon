# Environment Variables

# ============================================================
# SERVER
# ============================================================
NODE_ENV=development
PORT=5000

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/salon_db?schema=public"

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# BCRYPT
# ============================================================
BCRYPT_SALT_ROUNDS=12

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Deposit flat amount in dollars (e.g., 30 means $30)
DEPOSIT_AMOUNT=30

# ============================================================
# EMAIL (Nodemailer)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Salon Bookings <no-reply@salonbookings.com>"

# ============================================================
# CLIENT
# ============================================================
CLIENT_URL=http://localhost:3000

# Extra CORS origins — comma-separated exact matches (production frontend URL!)
# e.g. ALLOWED_ORIGINS=https://my-salon.vercel.app
ALLOWED_ORIGINS=
# Set to false once ALLOWED_ORIGINS covers every real frontend origin.
# While "true", any *.vercel.app / *.onrender.com origin is accepted.
CORS_ALLOW_WILDCARD=true

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ============================================================
# SCHEDULER
# ============================================================
# IANA timezone for cron jobs (reminders, completion marker, email queue)
SALON_TIMEZONE=America/New_York
